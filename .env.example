# DEVELOPMENT ONLY. The application does not exist yet; M0 must implement this contract.
NODE_ENV=development
CALENDAR_MODE=mock
CALENDAR_HOST=127.0.0.1
CALENDAR_PORT=3100
CALENDAR_STATE_DIR=.local/dev
CALENDAR_TIMEZONE=Asia/Tokyo
CALENDAR_ALLOWED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100,http://127.0.0.1:3310
CALENDAR_SYNC_INTERVAL_SECONDS=60
CALENDAR_LOG_LEVEL=info
# Never put Google secrets in NEXT_PUBLIC_* variables.
# Google client/tokens go under CALENDAR_STATE_DIR/secrets/ and are ignored by Git.
