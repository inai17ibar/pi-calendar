{
  "name": "pi-calendar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "node scripts/web.mjs dev",
    "start": "node scripts/web.mjs start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:e2e": "playwright test",
    "build": "next build --webpack && node scripts/package-web.mjs && node scripts/build-node.mjs",
    "test:runtime": "playwright test --config=playwright.runtime.config.ts",
    "worker": "node scripts/node-entry.mjs worker",
    "cli": "node scripts/node-entry.mjs cli"
  },
  "dependencies": {
    "luxon": "3.7.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "rolldown": "1.2.13",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
