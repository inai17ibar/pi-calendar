# TEMPLATE: rendered by ops/install/install-production.sh (replaces @NODE_BIN@). Do not enable the .in file directly.
[Unit]
Description=Pi Calendar local web UI
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=calendar-app
Group=calendar-app
WorkingDirectory=/opt/pi-calendar/current
EnvironmentFile=/etc/pi-calendar/runtime.env
# Never bind beyond loopback even if runtime.env is edited.
Environment=HOSTNAME=127.0.0.1
ExecStart=@NODE_BIN@ /opt/pi-calendar/current/dist/web/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pi-calendar
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
