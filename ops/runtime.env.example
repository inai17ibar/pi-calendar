# TEMPLATE. Copy to /etc/pi-calendar/runtime.env only after implementation/bootstrap.
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3000
CALENDAR_MODE=google
CALENDAR_HOST=127.0.0.1
CALENDAR_PORT=3000
CALENDAR_STATE_DIR=/var/lib/pi-calendar
CALENDAR_TIMEZONE=Asia/Tokyo
CALENDAR_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3300
CALENDAR_SYNC_INTERVAL_SECONDS=60
CALENDAR_LOG_LEVEL=info
